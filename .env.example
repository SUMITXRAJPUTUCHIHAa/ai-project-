# ==============================================================
# LPU Admission Intelligence - Environment Configuration
# ==============================================================

# Server Configuration
PORT=8080
FLASK_DEBUG=0
ADMIN_TOKEN=your-secure-admin-token-here

# Database Configuration (Firebase Firestore is Primary)
USE_FIREBASE=1
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Service Account credentials path
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=credentials/firebase-service-account.json

# Fallback Relational Database (Optional - PostgreSQL / SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
AUTO_SEED=1

# AI / LLM Integration (Groq Cloud API - Primary)
# Default model: openai/gpt-oss-120b (Ultra-fast 120B inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Alternative AI Providers (Optional Fallback)
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Knowledge Base Path (default: data/knowledge_base.json)
# KB_PATH=data/knowledge_base.json
